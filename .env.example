# FIRESight server configuration (the optional accounts side: sign-in, API keys, synced
# plans and the hosted MCP endpoint). Copy to .env.local for local use; on Vercel set
# these as environment variables, and mark the secrets Sensitive.
#
# None of this is needed to run the app. With DATABASE_URL, BETTER_AUTH_SECRET or
# PLAN_KEK missing, GET /api/config answers { "accounts": false }, the account
# endpoints answer 503, and the site works exactly as a static, local-first app.
#
# `npm run dev:api` needs none of it either: with DATABASE_URL unset it runs an
# embedded Postgres under .local/ and generates dev-only secrets beside it.

# --- Required for accounts --------------------------------------------------------

# Postgres. The pooled connection string serves requests; the direct ("unpooled") one
# is used by `npm run migrate` when present. Neon via the Vercel Marketplace sets both.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Signs session cookies and OAuth state. At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The key that wraps each user's plan-encryption key. Exactly 32 random bytes in
# base64: openssl rand -base64 32
# Losing it makes every synced plan unreadable. Keep a copy somewhere safe.
PLAN_KEK=

# The site's public origin, no path and no trailing slash, e.g. https://example.com.
# It is the OAuth issuer (<origin>/api/auth) and the MCP resource (<origin>/api/mcp),
# and cookies are bound to it. On Vercel it may be left unset in Production, where the
# project's production domain is used; Preview deployments have no accounts unless
# they are given one of their own. http is accepted for localhost only.
BETTER_AUTH_URL=

# --- Optional ---------------------------------------------------------------------

# Key rotation. To rotate: move the old key to PLAN_KEK_V<old version>, put the new key
# in PLAN_KEK and raise PLAN_KEK_VERSION. Each user's key is rewrapped under the new
# one the next time it is used, and `npm run rewrap` does the rest (users who have not
# been back). Drop the old variable only after `npm run rewrap` reports every data key
# on the current version, and keep a backup of the old key even then. Do not roll back
# to a deployment that lacks the new key: users already rewrapped could not be read
# until you roll forward again. docs/accounts.md, "Rotating the server key".
# PLAN_KEK_VERSION=1
# PLAN_KEK_V1=

# Social sign-in. A provider appears only when both of its values are set.
# Callback URLs: <origin>/api/auth/callback/github and <origin>/api/auth/callback/google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OAuth Dynamic Client Registration, for MCP clients that cannot identify themselves
# with a Client ID Metadata Document. Off by default: it lets anyone create client rows.
# (The endpoints that let a signed-in user create or edit a client are off either way.)
# FIRESIGHT_OAUTH_DCR=1

# Other origins allowed to call the cookie-authenticated API, comma-separated.
# FIRESIGHT_ALLOWED_ORIGINS=https://staging.example.com

# Other sites whose pages may call the MCP endpoint (/api/mcp) from a browser,
# comma-separated hosts or origins. The site itself, localhost, claude.ai, claude.com
# and chatgpt.com are always allowed, and clients that are not browsers send no Origin
# and are never blocked by this. Every call needs a bearer credential regardless.
# FIRESIGHT_MCP_ALLOWED_ORIGINS=https://tools.example.com

# --- Local development only (npm run dev:api) ---------------------------------------

# PORT=8787
# Where the embedded dev database lives (default .local/). "memory" keeps nothing.
# FIRESIGHT_DEV_DATA=memory
# HOST=localhost
# FIRESIGHT_DEV_QUIET=1 silences the request lines the dev server prints.
#
# BETTER_AUTH_URL defaults to http://localhost:5173 under dev:api, the address the
# browser is on when the web dev server (Vite) forwards /api here. If Vite runs on
# another port, set BETTER_AUTH_URL to that origin or sign-in is refused as cross-site.

# Read by the web dev server (cd web && npm run dev), not by the API: where it forwards
# /api and /.well-known. Only needed if dev:api is not on port 8787.
# FIRESIGHT_API_ORIGIN=http://localhost:8787

# --- Web build (not part of accounts) -----------------------------------------------

# Chrome origin-trial token for WebMCP, so that ordinary visitors' browsers offer the
# in-page tools to AI agents without a flag. Read at build time and written into the
# page as a meta tag; unset, nothing is added. A token is tied to one origin. Register
# the site's origin for the "WebMCP" trial (it ends 2027-03-30) at
# https://developer.chrome.com/origintrials/#/register_trial/4163014905550602241
# See docs/webmcp.md.
# VITE_WEBMCP_ORIGIN_TRIAL_TOKEN=

# --- The hosted assistant (api/chat.ts; independent of accounts) --------------------

# See docs/assistant.md. Setting the key turns hosted mode on for every visitor: put a
# spend limit on it.
# ANTHROPIC_API_KEY=
# FIRESIGHT_ACCESS_CODE=
# FIRESIGHT_RATE_PER_MINUTE=30
# FIRESIGHT_RATE_PER_DAY=600
