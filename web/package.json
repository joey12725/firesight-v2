{
  "name": "firesight-web",
  "private": true,
  "version": "2.0.0-alpha.1",
  "type": "module",
  "scripts": {
    "wasm": "cd .. && wasm-pack build crates/firesight-wasm --target web --release --out-dir ../../web/src/engine/pkg",
    "schema": "node scripts/schema.mjs",
    "data": "node scripts/copy-data.mjs",
    "prepare-engine": "npm run wasm && npm run schema && npm run data",
    "dev": "npm run data && vite",
    "build": "npm run prepare-engine && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "smoke": "node e2e/smoke.mjs",
    "journeys": "node e2e/journeys.mjs",
    "webmcp": "node e2e/webmcp.mjs",
    "accounts": "node e2e/accounts.mjs",
    "perf": "node e2e/perf.mjs",
    "docs-shots": "node e2e/docs-shots.mjs && python3 scripts/optimise-images.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@better-auth/api-key": "1.7.26",
    "@better-auth/oauth-provider": "1.7.26",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "better-auth": "1.7.26",
    "d3-array": "^3.2.5",
    "d3-format": "^3.1.3",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-array": "^3.2.2",
    "@types/d3-format": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "json-schema-to-typescript": "^16.0.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wasm-pack": "^0.15.1"
  }
}
